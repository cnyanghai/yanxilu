{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": [
  "format",
  "items"
 ],
 "properties": {
  "format": {
   "const": 1
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "item",
     "x",
     "y",
     "rot",
     "surface"
    ],
    "properties": {
     "item": {
      "type": "string"
     },
     "x": {
      "type": "integer"
     },
     "y": {
      "type": "integer"
     },
     "rot": {
      "enum": [
       0,
       90,
       180,
       270
      ]
     },
     "surface": {
      "enum": [
       "wall",
       "wallface",
       "sill",
       "floor",
       "desktop",
       "shelf",
       "rug",
       "soil",
       "door",
       "cubby",
       "rackslant"
      ]
     },
     "slot": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  }
 }
}
