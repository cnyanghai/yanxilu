{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": [
  "format",
  "rooms",
  "units"
 ],
 "properties": {
  "format": {
   "const": 1
  },
  "rooms": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "size",
     "grid",
     "slots",
     "defaultVis"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z_]+$"
     },
     "name": {
      "type": "string"
     },
     "size": {
      "type": "object",
      "required": [
       "w",
       "d",
       "h"
      ],
      "properties": {
       "w": {
        "type": "integer"
       },
       "d": {
        "type": "integer"
       },
       "h": {
        "type": "integer"
       }
      }
     },
     "grid": {
      "type": "object",
      "required": [
       "cell"
      ],
      "properties": {
       "cell": {
        "type": "integer",
        "minimum": 1
       }
      }
     },
     "slots": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "name",
        "type",
        "x",
        "z",
        "w",
        "d"
       ],
       "properties": {
        "name": {
         "type": "string"
        },
        "type": {
         "type": "string"
        },
        "x": {
         "type": "integer"
        },
        "z": {
         "type": "integer"
        },
        "w": {
         "type": "integer",
         "minimum": 1
        },
        "d": {
         "type": "integer",
         "minimum": 1
        },
        "rot": {
         "type": "number"
        },
        "fixed": {
         "type": "string"
        },
        "shop": {
         "type": "boolean"
        }
       },
       "additionalProperties": false
      }
     },
     "stations": {
      "type": "object"
     },
     "defaultVis": {
      "type": "string",
      "pattern": "^[a-z_]+:(dawn|day|dusk|night)$"
     }
    }
   }
  },
  "units": {
   "const": "cm"
  }
 }
}
