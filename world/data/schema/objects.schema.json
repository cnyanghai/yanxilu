{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": [
  "format",
  "functions",
  "objects",
  "units"
 ],
 "properties": {
  "format": {
   "const": 1
  },
  "functions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "objects": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "kind",
     "slotType",
     "footprint",
     "states",
     "operate"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z_]+$"
     },
     "kind": {
      "enum": [
       "fixed",
       "data",
       "shop"
      ]
     },
     "slotType": {
      "type": "string"
     },
     "footprint": {
      "type": "object",
      "required": [
       "w",
       "d"
      ],
      "properties": {
       "w": {
        "type": "integer",
        "minimum": 0
       },
       "d": {
        "type": "integer",
        "minimum": 0
       },
       "h": {
        "type": "integer",
        "minimum": 0
       }
      }
     },
     "states": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "name",
        "anim"
       ],
       "properties": {
        "name": {
         "type": "string"
        },
        "anim": {
         "type": "string"
        },
        "loop": {
         "type": "boolean",
         "description": "true 停住循环（Neutral / Opened），false 播一遍就转（Operating）——暗黑 2 的 loopCount 0 / 1"
        },
        "crossfade": {
         "type": "number",
         "minimum": 0,
         "description": "进入这个状态的淡接秒数；物件默认 0.01，角色默认 0.2"
        },
        "audio": {
         "type": "string"
        },
        "events": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "t",
           "kind"
          ],
          "properties": {
           "t": {
            "type": "number"
           },
           "kind": {
            "enum": [
             "sound",
             "vfx",
             "releasePoint",
             "light"
            ]
           }
          }
         }
        }
       }
      }
     },
     "operate": {
      "type": "object",
      "required": [
       "fn",
       "approach"
      ],
      "properties": {
       "fn": {
        "type": "string"
       },
       "approach": {
        "type": "string"
       }
      }
     },
     "light": {
      "type": "object",
      "required": [
       "type",
       "color",
       "power"
      ],
      "properties": {
       "type": {
        "enum": [
         "point",
         "spot"
        ]
       },
       "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
       }
      }
     },
     "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
     },
     "transitions": {
      "type": "string",
      "enum": [
       "any",
       "linear"
      ],
      "description": "any：任意态可转任意态（暗黑 2 物件与角色都是全连通）；linear：只按 states 顺序"
     }
    }
   }
  },
  "units": {
   "const": "cm"
  }
 }
}