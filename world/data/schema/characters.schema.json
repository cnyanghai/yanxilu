{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": [
  "format",
  "units",
  "holdables",
  "skeletons",
  "characters"
 ],
 "properties": {
  "format": {
   "const": 1
  },
  "units": {
   "const": "cm"
  },
  "holdables": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "fps": {
   "type": "integer"
  },
  "skeletons": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "file",
     "bones",
     "height"
    ],
    "properties": {
     "file": {
      "type": "string"
     },
     "bones": {
      "type": "integer",
      "maximum": 80
     },
     "height": {
      "type": "integer"
     }
    }
   }
  },
  "timelineEvents": {
   "type": "array",
   "items": {
    "enum": [
     "sound",
     "footprint",
     "releasePoint",
     "vfx",
     "equipLayer"
    ]
   }
  },
  "characters": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "skeleton",
     "height",
     "parts",
     "states",
     "bindings",
     "transitions"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "skeleton": {
      "type": "string"
     },
     "height": {
      "type": "integer"
     },
     "parts": {
      "type": "object",
      "additionalProperties": {
       "type": "object",
       "required": [
        "tiers"
       ],
       "properties": {
        "tiers": {
         "type": "array",
         "items": {
          "enum": [
           "base",
           "lit",
           "med",
           "hvy"
          ]
         },
         "minItems": 1
        }
       }
      }
     },
     "states": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": [
        "id",
        "name",
        "loop"
       ],
       "properties": {
        "id": {
         "type": "integer"
        },
        "name": {
         "type": "string",
         "pattern": "^[a-z_0-9]+$"
        },
        "loop": {
         "type": "boolean"
        },
        "releasePoint": {
         "type": "number",
         "minimum": 0,
         "maximum": 1
        }
       }
      }
     },
     "bindings": {
      "type": "object",
      "required": [
       "rule",
       "fallback"
      ]
     },
     "transitions": {
      "type": "object",
      "required": [
       "default"
      ],
      "properties": {
       "default": {
        "type": "object",
        "required": [
         "crossfade"
        ]
       },
       "exceptions": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "from",
          "to",
          "crossfade"
         ]
        }
       }
      }
     }
    }
   }
  }
 }
}