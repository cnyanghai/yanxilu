{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "type": "object",
 "required": [
  "format",
  "periods",
  "entries"
 ],
 "properties": {
  "format": {
   "const": 1
  },
  "entries": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "room",
     "period",
     "exposure",
     "key",
     "fog",
     "lut",
     "unitLight",
     "bakeSet"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "room": {
      "type": "string"
     },
     "period": {
      "enum": [
       "dawn",
       "day",
       "dusk",
       "night"
      ]
     },
     "exposure": {
      "type": "number",
      "minimum": 0,
      "maximum": 4
     },
     "key": {
      "type": "object",
      "required": [
       "color",
       "power"
      ],
      "properties": {
       "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
       },
       "power": {
        "type": "number",
        "minimum": 0
       }
      }
     },
     "fog": {
      "type": "object",
      "required": [
       "color",
       "density"
      ],
      "properties": {
       "color": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
       },
       "density": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       }
      }
     },
     "lut": {
      "type": "string"
     },
     "unitLight": {
      "type": "object",
      "required": [
       "power",
       "radius"
      ]
     },
     "bakeSet": {
      "enum": [
       "dawn",
       "day",
       "dusk",
       "night"
      ]
     },
     "ibl": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "环境图强度（暗黑 2 iblIntensity：户外白天 .4 黄昏 .65 夜 .1）；渲染时按 ibl^0.4 映射"
     },
     "characterShadow": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "角色影子深浅（暗黑 2 characterShadowDarkness：白天 .9 夜 .7）"
     },
     "characterBrightness": {
      "type": "number",
      "minimum": 0,
      "description": "角色亮度系数（暗黑 2 .4）"
     },
     "itemBrightness": {
      "type": "number",
      "minimum": 0,
      "description": "掉落物 / 可拾取物亮度系数（暗黑 2 2.0），让东西从地上跳出来"
     }
    }
   }
  },
  "mapping": {
   "type": "object",
   "description": "功率到引擎强度的映射曲线说明，渲染层照此实现"
  }
 }
}